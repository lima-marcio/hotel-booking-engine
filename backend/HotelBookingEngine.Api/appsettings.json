{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=HotelBookingEngine;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "HotelBookingEngine",
    "Audience": "HotelBookingEngine.Client",
    "SigningKey": "REPLACE_WITH_A_REAL_SECRET_IN_PRODUCTION_MIN_32_CHARS",
    "ExpiryMinutes": 60
  }
}
